+/* Edit designers (IHTMLEditServices::AddDesigner) see keyboard events before and
+ * after the editor handled them. The "after" half has to wait until Gecko has
+ * performed the default action (e.g. inserted the typed character), so it is
+ * deferred to a task. */
+typedef struct {
+    task_t header;
+    IHTMLEditServices *editsvcs;
+    IHTMLEventObj *event_obj;
+    DISPID id;
+} designer_task_t;
+
+static void designer_post_proc(task_t *_task)
+{
+    designer_task_t *task = (designer_task_t*)_task;
+    edit_designers_post_handle(task->editsvcs, task->id, task->event_obj);
+}
+
+static void designer_post_destr(task_t *_task)
+{
+    designer_task_t *task = (designer_task_t*)_task;
+    IHTMLEventObj_Release(task->event_obj);
+    IHTMLEditServices_Release(task->editsvcs);
+}
+
+static void notify_edit_designers(HTMLDocumentNode *doc, DOMEvent *event, nsIDOMEvent *nsevent)
+{
+    IHTMLEditServices *editsvcs;
+    IHTMLEventObj *event_obj;
+    designer_task_t *task;
+    DISPID id;
+
+    switch(event->event_id) {
+    case EVENTID_KEYDOWN:  id = -602; break;   /* DISPID_HTMLELEMENTEVENTS_ONKEYDOWN */
+    case EVENTID_KEYPRESS: id = -603; break;   /* DISPID_HTMLELEMENTEVENTS_ONKEYPRESS */
+    case EVENTID_KEYUP:    id = -604; break;   /* DISPID_HTMLELEMENTEVENTS_ONKEYUP */
+    default: return;
+    }
+
+    if(!doc->doc_obj || !(editsvcs = doc->doc_obj->editsvcs) || !has_edit_designers(editsvcs))
+        return;
+
+    if(FAILED(create_event_obj(event, doc, &event_obj)))
+        return;
+
+    IHTMLEditServices_AddRef(editsvcs);
+
+    if(edit_designers_pre_handle(editsvcs, id, event_obj) == S_OK) {
+        nsIDOMEvent_PreventDefault(nsevent);
+        IHTMLEventObj_Release(event_obj);
+        IHTMLEditServices_Release(editsvcs);
+        return;
+    }
+
+    if(!(task = calloc(1, sizeof(*task)))) {
+        IHTMLEventObj_Release(event_obj);
+        IHTMLEditServices_Release(editsvcs);
+        return;
+    }
+
+    task->editsvcs = editsvcs;
+    task->event_obj = event_obj;
+    task->id = id;
+    push_task(&task->header, designer_post_proc, designer_post_destr, doc->doc_obj->task_magic);
+}
