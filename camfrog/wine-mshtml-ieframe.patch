+static IStream *copy_stream(IStream *src)
+{
+    IStream *dst = NULL;
+    LARGE_INTEGER zero = {0};
+    char buf[8192];
+    ULONG read;
+    HRESULT hres;
+
+    if(!src)
+        return NULL;
+
+    hres = CreateStreamOnHGlobal(NULL, TRUE, &dst);
+    if(FAILED(hres)) {
+        WARN("CreateStreamOnHGlobal failed: %08lx\n", hres);
+        return NULL;
+    }
+
+    IStream_Seek(src, zero, STREAM_SEEK_SET, NULL);
+    while(SUCCEEDED(hres = IStream_Read(src, buf, sizeof(buf), &read)) && read) {
+        hres = IStream_Write(dst, buf, read, NULL);
+        if(FAILED(hres)) {
+            IStream_Release(dst);
+            return NULL;
+        }
+    }
+
+    IStream_Seek(dst, zero, STREAM_SEEK_SET, NULL);
+    return dst;
+}
+
+/* Does this stream look like HTML rather than persisted control state? */
+static BOOL stream_is_html(IStream *stm)
+{
+    static const char bom_utf8[] = "\xef\xbb\xbf";
+    unsigned char head[512];
+    LARGE_INTEGER zero = {0};
+    ULONG read = 0, i = 0;
+    HRESULT hres;
+
+    IStream_Seek(stm, zero, STREAM_SEEK_SET, NULL);
+    hres = IStream_Read(stm, head, sizeof(head), &read);
+    IStream_Seek(stm, zero, STREAM_SEEK_SET, NULL);
+    if(FAILED(hres) || !read)
+        return FALSE;
+
+    if(read >= 3 && !memcmp(head, bom_utf8, 3))
+        i = 3;
+    /* UTF-16 BOM */
+    if(read >= 4 && (head[0] == 0xff && head[1] == 0xfe)) {
+        unsigned i2;
+        for(i2 = 2; i2 + 1 < read; i2 += 2)
+            if(head[i2] == '<' && head[i2+1] == 0)
+                return TRUE;
+        return FALSE;
+    }
+    if(read >= 2 && head[0] == 0xfe && head[1] == 0xff)
+        return FALSE;
+
+    while(i < read && (head[i] == ' ' || head[i] == '\t' || head[i] == '\r' || head[i] == '\n'))
+        i++;
+
+    return i < read && head[i] == '<';
+}
+
+/* Hand an HTML stream to the hosted document. */
+HRESULT doc_host_load_html_stream(DocHost *This, IStream *stm)
+{
+    IPersistStreamInit *psi;
+    LARGE_INTEGER zero = {0};
+    HRESULT hres;
+
+    if(!This->document || !stm)
+        return S_FALSE;
+
+    hres = IUnknown_QueryInterface(This->document, &IID_IPersistStreamInit, (void**)&psi);
+    if(FAILED(hres)) {
+        WARN("document has no IPersistStreamInit: %08lx\n", hres);
+        return hres;
+    }
+
+    IStream_Seek(stm, zero, STREAM_SEEK_SET, NULL);
+    TRACE("loading %p into document %p\n", stm, This->document);
+    hres = IPersistStreamInit_Load(psi, stm);
+    IPersistStreamInit_Release(psi);
+    if(FAILED(hres))
+        WARN("document stream load failed: %08lx\n", hres);
+    return hres;
+}
