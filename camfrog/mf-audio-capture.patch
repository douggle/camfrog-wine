+
+static HRESULT sac_create_type(WORD tag, WORD channels, DWORD rate, IMFMediaType **type)
+{
+    WAVEFORMATEX format = {0};
+    HRESULT hr;
+
+    format.wFormatTag = tag;
+    format.nChannels = channels;
+    format.nSamplesPerSec = rate;
+    format.wBitsPerSample = tag == WAVE_FORMAT_IEEE_FLOAT ? 32 : 16;
+    format.nBlockAlign = channels * format.wBitsPerSample / 8;
+    format.nAvgBytesPerSec = rate * format.nBlockAlign;
+
+    if (FAILED(hr = MFCreateMediaType(type)))
+        return hr;
+    if (FAILED(hr = MFInitMediaTypeFromWaveFormatEx(*type, &format, sizeof(format))))
+    {
+        IMFMediaType_Release(*type);
+        *type = NULL;
+    }
+    return hr;
+}
+
+HRESULT create_audio_capture_source(IMFAttributes *attributes, IMFMediaSource **out)
+{
+    static const DWORD common_rates[] = {48000, 44100, 32000, 16000, 8000};
+    static const WORD tags[] = {WAVE_FORMAT_PCM, WAVE_FORMAT_IEEE_FLOAT};
+    IMFMediaType *types[SAC_MAX_TYPES] = {0};
+    struct audio_capture_source *source;
+    DWORD rates[ARRAY_SIZE(common_rates) + 1];
+    unsigned int i, r, c, t, rate_count = 0, type_count = 0;
+    IMFMediaTypeHandler *handler;
+    WAVEFORMATEX *mix = NULL;
+    IAudioClient *client;
+    IMMDevice *device;
+    HRESULT hr, coinit;
+    WORD channels[2];
+    UINT32 length;
+    UINT32 role;
+
+    *out = NULL;
+
+    if (!(source = calloc(1, sizeof(*source))))
+        return E_OUTOFMEMORY;
+
+    source->IMFMediaSource_iface.lpVtbl = &sac_source_vtbl;
+    source->IMFMediaStream_iface.lpVtbl = &sac_stream_vtbl;
+    source->refcount = 1;
+    source->role = eCommunications;
+    list_init(&source->samples);
+    list_init(&source->requests);
+    InitializeCriticalSection(&source->cs);
+
+    if (attributes)
+    {
+        if (SUCCEEDED(IMFAttributes_GetUINT32(attributes, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_AUDCAP_ROLE, &role)))
+            source->role = role;
+        if (SUCCEEDED(IMFAttributes_GetStringLength(attributes, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_AUDCAP_ENDPOINT_ID,
+                &length)) && (source->endpoint_id = calloc(length + 1, sizeof(WCHAR))))
+        {
+            if (FAILED(IMFAttributes_GetString(attributes, &MF_DEVSOURCE_ATTRIBUTE_SOURCE_TYPE_AUDCAP_ENDPOINT_ID,
+                    source->endpoint_id, length + 1, NULL)))
+            {
+                free(source->endpoint_id);
+                source->endpoint_id = NULL;
+            }
+        }
+    }
+
+    TRACE("endpoint %s, role %d.\n", debugstr_w(source->endpoint_id), source->role);
+
+    /* Query the device mix format to build the list of native types. */
+    coinit = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    if (SUCCEEDED(hr = sac_open_device(source->endpoint_id, source->role, &device)))
+    {
+        if (SUCCEEDED(hr = IMMDevice_Activate(device, &sac_IID_IAudioClient, CLSCTX_INPROC_SERVER, NULL,
+                (void **)&client)))
+        {
+            hr = IAudioClient_GetMixFormat(client, &mix);
+            IAudioClient_Release(client);
+        }
+        IMMDevice_Release(device);
+    }
+    if (SUCCEEDED(coinit))
+        CoUninitialize();
+    if (FAILED(hr))
+    {
+        WARN("Failed to query capture device, hr %#lx.\n", hr);
+        goto failed;
+    }
+
+    channels[0] = mix->nChannels >= 2 ? 2 : 1;
+    channels[1] = channels[0] == 2 ? 1 : 2;
+    rates[rate_count++] = mix->nSamplesPerSec;
+    for (i = 0; i < ARRAY_SIZE(common_rates); ++i)
+        if (common_rates[i] != mix->nSamplesPerSec)
+            rates[rate_count++] = common_rates[i];
+    CoTaskMemFree(mix);
+
+    for (r = 0; r < rate_count; ++r)
+        for (c = 0; c < ARRAY_SIZE(channels); ++c)
+            for (t = 0; t < ARRAY_SIZE(tags); ++t)
+            {
+                if (type_count >= SAC_MAX_TYPES)
+                    break;
+                if (FAILED(hr = sac_create_type(tags[t], channels[c], rates[r], &types[type_count])))
+                    goto failed;
+                ++type_count;
+            }
+
+    if (FAILED(hr = MFCreateStreamDescriptor(0, type_count, types, &source->sd)))
+        goto failed;
+    if (SUCCEEDED(IMFStreamDescriptor_GetMediaTypeHandler(source->sd, &handler)))
+    {
+        IMFMediaTypeHandler_SetCurrentMediaType(handler, types[0]);
+        IMFMediaTypeHandler_Release(handler);
+    }
+    if (FAILED(hr = MFCreatePresentationDescriptor(1, &source->sd, &source->pd)))
+        goto failed;
+    IMFPresentationDescriptor_SelectStream(source->pd, 0);
+
+    if (FAILED(hr = MFCreateEventQueue(&source->event_queue)))
+        goto failed;
+    if (FAILED(hr = MFCreateEventQueue(&source->stream_event_queue)))
+        goto failed;
+
+    if (!(source->stop_event = CreateEventW(NULL, TRUE, FALSE, NULL))
+            || !(source->ready_event = CreateEventW(NULL, TRUE, FALSE, NULL)))
+    {
+        hr = E_OUTOFMEMORY;
+        goto failed;
+    }
+
+    for (i = 0; i < type_count; ++i)
+        IMFMediaType_Release(types[i]);
+
+    TRACE("Created audio capture source %p with %u native types.\n", source, type_count);
+    *out = &source->IMFMediaSource_iface;
+    return S_OK;
+
+failed:
+    for (i = 0; i < type_count; ++i)
+        if (types[i])
+            IMFMediaType_Release(types[i]);
+    sac_source_destroy(source);
+    return hr;
+}
