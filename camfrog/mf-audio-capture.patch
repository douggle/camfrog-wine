+
+static HRESULT WINAPI sac_stream_RequestSample(IMFMediaStream *iface, IUnknown *token)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaStream(iface);
+    struct sac_request *request;
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %p.\n", iface, token);
+
+    EnterCriticalSection(&source->cs);
+    if (source->state == SAC_STATE_SHUTDOWN)
+        hr = MF_E_SHUTDOWN;
+    else if (source->state == SAC_STATE_STOPPED)
+        hr = MF_E_MEDIA_SOURCE_WRONGSTATE;
+    else if (!(request = calloc(1, sizeof(*request))))
+        hr = E_OUTOFMEMORY;
+    else
+    {
+        if ((request->token = token))
+            IUnknown_AddRef(token);
+        list_add_tail(&source->requests, &request->entry);
+        sac_deliver_samples(source);
+    }
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
