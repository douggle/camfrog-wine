+static HRESULT WINAPI sac_source_Start(IMFMediaSource *iface, IMFPresentationDescriptor *pd, const GUID *time_format,
+        const PROPVARIANT *position)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaSource(iface);
+    WAVEFORMATEX *format = NULL;
+    BOOL restart = FALSE;
+    PROPVARIANT empty;
+    HRESULT hr;
+
+    TRACE("%p, %p, %s, %p.\n", iface, pd, debugstr_guid(time_format), position);
+
+    if (time_format && !IsEqualGUID(time_format, &GUID_NULL))
+        return MF_E_UNSUPPORTED_TIME_FORMAT;
+
+    PropVariantInit(&empty);
+    if (!position)
+        position = &empty;
+
+    if (source->state == SAC_STATE_SHUTDOWN)
+        return MF_E_SHUTDOWN;
+
+    if (FAILED(hr = sac_get_selected_format(source, pd, &format)))
+        return hr;
+
+    EnterCriticalSection(&source->cs);
+    if (source->thread && source->format && (source->format->wFormatTag != format->wFormatTag
+            || source->format->nChannels != format->nChannels
+            || source->format->nSamplesPerSec != format->nSamplesPerSec
+            || source->format->wBitsPerSample != format->wBitsPerSample))
+        restart = TRUE;
+    LeaveCriticalSection(&source->cs);
+
+    if (restart)
+        sac_stop_thread(source);
+
+    EnterCriticalSection(&source->cs);
+
+    if (source->state == SAC_STATE_SHUTDOWN)
+        hr = MF_E_SHUTDOWN;
+    else if (!source->thread)
+    {
+        sac_flush(source);
+        CoTaskMemFree(source->format);
+        source->format = format;
+        format = NULL;
+
+        ResetEvent(source->ready_event);
+        ResetEvent(source->stop_event);
+        source->thread_hr = E_FAIL;
+        if (!(source->thread = CreateThread(NULL, 0, sac_capture_thread, source, 0, NULL)))
+            hr = HRESULT_FROM_WIN32(GetLastError());
+        else
+        {
+            WaitForSingleObject(source->ready_event, INFINITE);
+            if (FAILED(hr = source->thread_hr))
+            {
+                WaitForSingleObject(source->thread, INFINITE);
+                CloseHandle(source->thread);
+                source->thread = NULL;
+            }
+        }
+    }
+
+    if (SUCCEEDED(hr))
+    {
+        source->state = SAC_STATE_RUNNING;
+        IMFMediaEventQueue_QueueEventParamUnk(source->event_queue, source->stream_sent ? MEUpdatedStream : MENewStream,
+                &GUID_NULL, S_OK, (IUnknown *)&source->IMFMediaStream_iface);
+        source->stream_sent = TRUE;
+        IMFMediaEventQueue_QueueEventParamVar(source->event_queue, MESourceStarted, &GUID_NULL, S_OK, position);
+        IMFMediaEventQueue_QueueEventParamVar(source->stream_event_queue, MEStreamStarted, &GUID_NULL, S_OK, position);
+    }
+    else
+        WARN("Failed to start audio capture, hr %#lx.\n", hr);
+
+    LeaveCriticalSection(&source->cs);
+
+    CoTaskMemFree(format);
+    return hr;
+}
+
+static HRESULT WINAPI sac_source_Stop(IMFMediaSource *iface)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaSource(iface);
+
+    TRACE("%p.\n", iface);
+
+    if (source->state == SAC_STATE_SHUTDOWN)
+        return MF_E_SHUTDOWN;
+
+    sac_stop_thread(source);
+
+    EnterCriticalSection(&source->cs);
+    if (source->state != SAC_STATE_SHUTDOWN)
+    {
+        source->state = SAC_STATE_STOPPED;
+        sac_flush(source);
+        IMFMediaEventQueue_QueueEventParamVar(source->event_queue, MESourceStopped, &GUID_NULL, S_OK, NULL);
+        IMFMediaEventQueue_QueueEventParamVar(source->stream_event_queue, MEStreamStopped, &GUID_NULL, S_OK, NULL);
+    }
+    LeaveCriticalSection(&source->cs);
+
+    return S_OK;
+}
+
+static HRESULT WINAPI sac_source_Pause(IMFMediaSource *iface)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaSource(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&source->cs);
+    if (source->state == SAC_STATE_SHUTDOWN)
+        hr = MF_E_SHUTDOWN;
+    else if (source->state != SAC_STATE_RUNNING)
+        hr = MF_E_INVALID_STATE_TRANSITION;
+    else
+    {
+        source->state = SAC_STATE_PAUSED;
+        IMFMediaEventQueue_QueueEventParamVar(source->event_queue, MESourcePaused, &GUID_NULL, S_OK, NULL);
+        IMFMediaEventQueue_QueueEventParamVar(source->stream_event_queue, MEStreamPaused, &GUID_NULL, S_OK, NULL);
+    }
+    LeaveCriticalSection(&source->cs);
+
+    return hr;
+}
+
+static HRESULT WINAPI sac_source_Shutdown(IMFMediaSource *iface)
+{
+    struct audio_capture_source *source = impl_from_IMFMediaSource(iface);
+
+    TRACE("%p.\n", iface);
+
+    if (source->state == SAC_STATE_SHUTDOWN)
+        return MF_E_SHUTDOWN;
+
+    sac_stop_thread(source);
+
+    EnterCriticalSection(&source->cs);
+    source->state = SAC_STATE_SHUTDOWN;
+    sac_flush(source);
+    IMFMediaEventQueue_Shutdown(source->event_queue);
+    IMFMediaEventQueue_Shutdown(source->stream_event_queue);
+    LeaveCriticalSection(&source->cs);
+
+    return S_OK;
+}
