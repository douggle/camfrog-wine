--- a/dlls/mf/sac.c	2026-10-30 13:52:31.000000000 -0700
+++ b/dlls/mf/sac.c	2026-11-12 07:04:17.966816949 -0800
@@ -28,14 +28,903 @@
 #include "devpkey.h"
 
 #include "wine/debug.h"
+#include "wine/list.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(mfplat);
 
+/*
+ * Audio capture media source (local addition for Camfrog): a live IMFMediaSource with a
+ * single PCM stream, fed by a WASAPI shared-mode capture client.
+ */
+
+static const GUID sac_IID_IAudioClient = {0x1cb9ad4c,0xdbfa,0x4c32,{0xb1,0x78,0xc2,0xf5,0x68,0xa7,0x03,0xb2}};
+static const GUID sac_IID_IAudioCaptureClient = {0xc8adbd64,0xe71e,0x48a0,{0xa4,0xde,0x18,0x5c,0x39,0x5c,0xd3,0x17}};
+
+#define SAC_MAX_QUEUED_SAMPLES 100
+#define SAC_MAX_TYPES 32
+
+enum sac_state
+{
+    SAC_STATE_STOPPED = 0,
+    SAC_STATE_RUNNING,
+    SAC_STATE_PAUSED,
+    SAC_STATE_SHUTDOWN,
+};
+
+struct sac_sample
+{
+    struct list entry;
+    IMFSample *sample;
+};
+
+struct sac_request
+{
+    struct list entry;
+    IUnknown *token;
+};
+
+struct audio_capture_source
+{
+    IMFMediaSource IMFMediaSource_iface;
+    IMFMediaStream IMFMediaStream_iface;
+    LONG refcount;
+
+    IMFMediaEventQueue *event_queue;
+    IMFMediaEventQueue *stream_event_queue;
+    IMFPresentationDescriptor *pd;
+    IMFStreamDescriptor *sd;
+
+    WCHAR *endpoint_id;
+    ERole role;
+
+    CRITICAL_SECTION cs;
+    enum sac_state state;
+    BOOL stream_sent;
+
+    WAVEFORMATEX *format;
+    HANDLE thread;
+    HANDLE stop_event;
+    HANDLE ready_event;
+    HRESULT thread_hr;
+
+    struct list samples;
+    unsigned int sample_count;
+    struct list requests;
+};
+
+static struct audio_capture_source *impl_from_IMFMediaSource(IMFMediaSource *iface)
+{
+    return CONTAINING_RECORD(iface, struct audio_capture_source, IMFMediaSource_iface);
+}
+
+static struct audio_capture_source *impl_from_IMFMediaStream(IMFMediaStream *iface)
+{
+    return CONTAINING_RECORD(iface, struct audio_capture_source, IMFMediaStream_iface);
+}
+
+static HRESULT sac_open_device(const WCHAR *endpoint_id, ERole role, IMMDevice **device)
+{
+    IMMDeviceEnumerator *devenum;
+    HRESULT hr;
+
+    *device = NULL;
+    if (FAILED(hr = CoCreateInstance(&CLSID_MMDeviceEnumerator, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMMDeviceEnumerator, (void **)&devenum)))
+        return hr;
+
+    hr = E_FAIL;
+    if (endpoint_id && FAILED(hr = IMMDeviceEnumerator_GetDevice(devenum, endpoint_id, device)))
+        WARN("Failed to open endpoint %s, hr %#lx, using the default one.\n", debugstr_w(endpoint_id), hr);
+    if (FAILED(hr))
+        hr = IMMDeviceEnumerator_GetDefaultAudioEndpoint(devenum, eCapture, role, device);
+
+    IMMDeviceEnumerator_Release(devenum);
+    return hr;
+}
+
+/* Called with source->cs held. */
+static void sac_deliver_samples(struct audio_capture_source *source)
+{
+    struct sac_request *request;
+    struct sac_sample *sample;
+    struct list *r, *s;
+
+    while ((r = list_head(&source->requests)) && (s = list_head(&source->samples)))
+    {
+        request = LIST_ENTRY(r, struct sac_request, entry);
+        sample = LIST_ENTRY(s, struct sac_sample, entry);
+        list_remove(r);
+        list_remove(s);
+        --source->sample_count;
+
+        if (request->token)
+        {
+            IMFSample_SetUnknown(sample->sample, &MFSampleExtension_Token, request->token);
+            IUnknown_Release(request->token);
+        }
+        IMFMediaEventQueue_QueueEventParamUnk(source->stream_event_queue, MEMediaSample, &GUID_NULL, S_OK,
+                (IUnknown *)sample->sample);
+        IMFSample_Release(sample->sample);
+        free(sample);
+        free(request);
+    }
+}
+
+/* Called with source->cs held. */
+static void sac_flush(struct audio_capture_source *source)
+{
+    struct sac_request *request, *request2;
+    struct sac_sample *sample, *sample2;
+
+    LIST_FOR_EACH_ENTRY_SAFE(sample, sample2, &source->samples, struct sac_sample, entry)
+    {
+        list_remove(&sample->entry);
+        IMFSample_Release(sample->sample);
+        free(sample);
+    }
+    source->sample_count = 0;
+
+    LIST_FOR_EACH_ENTRY_SAFE(request, request2, &source->requests, struct sac_request, entry)
+    {
+        list_remove(&request->entry);
+        if (request->token)
+            IUnknown_Release(request->token);
+        free(request);
+    }
+}
+
+static void sac_queue_captured(struct audio_capture_source *source, const BYTE *data, UINT32 frames,
+        DWORD flags, const WAVEFORMATEX *format, UINT64 position)
+{
+    DWORD size = frames * format->nBlockAlign;
+    struct sac_sample *entry, *oldest;
+    IMFMediaBuffer *buffer;
+    IMFSample *sample;
+    BYTE *dst;
+
+    if (FAILED(MFCreateMemoryBuffer(size, &buffer)))
+        return;
+    if (SUCCEEDED(IMFMediaBuffer_Lock(buffer, &dst, NULL, NULL)))
+    {
+        if (flags & AUDCLNT_BUFFERFLAGS_SILENT)
+            memset(dst, 0, size);
+        else
+            memcpy(dst, data, size);
+        IMFMediaBuffer_Unlock(buffer);
+    }
+    IMFMediaBuffer_SetCurrentLength(buffer, size);
+
+    if (FAILED(MFCreateSample(&sample)))
+    {
+        IMFMediaBuffer_Release(buffer);
+        return;
+    }
+    IMFSample_AddBuffer(sample, buffer);
+    IMFMediaBuffer_Release(buffer);
+    IMFSample_SetSampleTime(sample, (LONGLONG)(position * 10000000 / format->nSamplesPerSec));
+    IMFSample_SetSampleDuration(sample, (LONGLONG)((UINT64)frames * 10000000 / format->nSamplesPerSec));
+
+    if (!(entry = calloc(1, sizeof(*entry))))
+    {
+        IMFSample_Release(sample);
+        return;
+    }
+    entry->sample = sample;
+
+    EnterCriticalSection(&source->cs);
+    if (source->state != SAC_STATE_RUNNING)
+    {
+        IMFSample_Release(sample);
+        free(entry);
+    }
+    else
+    {
+        list_add_tail(&source->samples, &entry->entry);
+        if (++source->sample_count > SAC_MAX_QUEUED_SAMPLES)
+        {
+            oldest = LIST_ENTRY(list_head(&source->samples), struct sac_sample, entry);
+            list_remove(&oldest->entry);
+            IMFSample_Release(oldest->sample);
+            free(oldest);
+            --source->sample_count;
+        }
+        sac_deliver_samples(source);
+    }
+    LeaveCriticalSection(&source->cs);
+}
+
+static DWORD CALLBACK sac_capture_thread(void *arg)
+{
+    struct audio_capture_source *source = arg;
+    const WAVEFORMATEX *format = source->format;
+    IAudioCaptureClient *capture = NULL;
+    IAudioClient *client = NULL;
+    IMMDevice *device = NULL;
+    UINT64 position = 0;
+    HRESULT hr, coinit;
+
+    coinit = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+
+    if (SUCCEEDED(hr = sac_open_device(source->endpoint_id, source->role, &device)))
+        hr = IMMDevice_Activate(device, &sac_IID_IAudioClient, CLSCTX_INPROC_SERVER, NULL, (void **)&client);
+    if (SUCCEEDED(hr))
+        hr = IAudioClient_Initialize(client, AUDCLNT_SHAREMODE_SHARED,
+                AUDCLNT_STREAMFLAGS_AUTOCONVERTPCM | AUDCLNT_STREAMFLAGS_SRC_DEFAULT_QUALITY,
+                10000000, 0, format, NULL);
+    if (SUCCEEDED(hr))
+        hr = IAudioClient_GetService(client, &sac_IID_IAudioCaptureClient, (void **)&capture);
+    if (SUCCEEDED(hr))
+        hr = IAudioClient_Start(client);
+
+    TRACE("source %p, capture start hr %#lx (%u Hz, %u ch, %u bits, tag %#x).\n", source, hr,
+            (unsigned int)format->nSamplesPerSec, format->nChannels, format->wBitsPerSample, format->wFormatTag);
+
+    source->thread_hr = hr;
+    SetEvent(source->ready_event);
+
+    if (SUCCEEDED(hr))
+    {
+        while (WaitForSingleObject(source->stop_event, 10) == WAIT_TIMEOUT)
+        {
+            for (;;)
+            {
+                UINT32 packet = 0, frames = 0;
+                DWORD flags = 0;
+                BYTE *data;
+
+                if (FAILED(IAudioCaptureClient_GetNextPacketSize(capture, &packet)) || !packet)
+                    break;
+                if (IAudioCaptureClient_GetBuffer(capture, &data, &frames, &flags, NULL, NULL) != S_OK)
+                    break;
+                if (frames)
+                    sac_queue_captured(source, data, frames, flags, format, position);
+                position += frames;
+                IAudioCaptureClient_ReleaseBuffer(capture, frames);
+            }
+        }
+        IAudioClient_Stop(client);
+    }
+
+    if (capture)
+        IAudioCaptureClient_Release(capture);
+    if (client)
+        IAudioClient_Release(client);
+    if (device)
+        IMMDevice_Release(device);
+    if (SUCCEEDED(coinit))
+        CoUninitialize();
+
+    TRACE("source %p, capture thread exiting.\n", source);
+    return 0;
+}
+
+/* Must be called without source->cs held. */
+static void sac_stop_thread(struct audio_capture_source *source)
+{
+    HANDLE thread;
+
+    EnterCriticalSection(&source->cs);
+    thread = source->thread;
+    source->thread = NULL;
+    LeaveCriticalSection(&source->cs);
+
+    if (thread)
+    {
+        SetEvent(source->stop_event);
+        WaitForSingleObject(thread, INFINITE);
+        CloseHandle(thread);
+        ResetEvent(source->stop_event);
+    }
+}
+
+static HRESULT sac_get_selected_format(struct audio_capture_source *source, IMFPresentationDescriptor *pd,
+        WAVEFORMATEX **format)
+{
+    IMFMediaTypeHandler *handler;
+    IMFStreamDescriptor *sd = NULL;
+    IMFMediaType *type = NULL;
+    BOOL selected;
+    UINT32 size;
+    HRESULT hr;
+
+    *format = NULL;
+
+    if (!pd || FAILED(IMFPresentationDescriptor_GetStreamDescriptorByIndex(pd, 0, &selected, &sd)))
+    {
+        sd = source->sd;
+        IMFStreamDescriptor_AddRef(sd);
+    }
+
+    hr = IMFStreamDescriptor_GetMediaTypeHandler(sd, &handler);
+    IMFStreamDescriptor_Release(sd);
+    if (FAILED(hr))
+        return hr;
+
+    if (FAILED(hr = IMFMediaTypeHandler_GetCurrentMediaType(handler, &type)))
+        hr = IMFMediaTypeHandler_GetMediaTypeByIndex(handler, 0, &type);
+    IMFMediaTypeHandler_Release(handler);
+    if (FAILED(hr))
+        return hr;
+
+    hr = MFCreateWaveFormatExFromMFMediaType(type, format, &size, MFWaveFormatExConvertFlag_Normal);
+    IMFMediaType_Release(type);
+    if (FAILED(hr))
+        return hr;
+
+    if (((*format)->wFormatTag != WAVE_FORMAT_PCM && (*format)->wFormatTag != WAVE_FORMAT_IEEE_FLOAT)
+            || !(*format)->nChannels || (*format)->nChannels > 2 || !(*format)->nSamplesPerSec
+            || !(*format)->nBlockAlign)
+    {
+        WARN("Unsupported capture format (tag %#x, %u ch).\n", (*format)->wFormatTag, (*format)->nChannels);
+        CoTaskMemFree(*format);
+        *format = NULL;
+        return MF_E_INVALIDMEDIATYPE;
+    }
+
+    return S_OK;
+}
+
+static void sac_source_destroy(struct audio_capture_source *source)
+{
+    sac_stop_thread(source);
+
+    EnterCriticalSection(&source->cs);
+    sac_flush(source);
+    LeaveCriticalSection(&source->cs);
+
+    if (source->event_queue)
+    {
+        IMFMediaEventQueue_Shutdown(source->event_queue);
+        IMFMediaEventQueue_Release(source->event_queue);
+    }
+    if (source->stream_event_queue)
+    {
+        IMFMediaEventQueue_Shutdown(source->stream_event_queue);
+        IMFMediaEventQueue_Release(source->stream_event_queue);
+    }
+    if (source->pd)
+        IMFPresentationDescriptor_Release(source->pd);
+    if (source->sd)
+        IMFStreamDescriptor_Release(source->sd);
+    if (source->stop_event)
+        CloseHandle(source->stop_event);
+    if (source->ready_event)
+        CloseHandle(source->ready_event);
+    CoTaskMemFree(source->format);
+    free(source->endpoint_id);
+    DeleteCriticalSection(&source->cs);
+    free(source);
+}
