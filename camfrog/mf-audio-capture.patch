+static const IMFMediaSourceVtbl sac_source_vtbl =
+{
+    sac_source_QueryInterface,
+    sac_source_AddRef,
+    sac_source_Release,
+    sac_source_GetEvent,
+    sac_source_BeginGetEvent,
+    sac_source_EndGetEvent,
+    sac_source_QueueEvent,
