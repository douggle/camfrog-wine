diff --git a/dlls/qcap/vfwcapture.c b/dlls/qcap/vfwcapture.c
index eb4cd5e..e19a62b 100644
--- a/dlls/qcap/vfwcapture.c
+++ b/dlls/qcap/vfwcapture.c
@@ -143,10 +143,12 @@ static DWORD WINAPI stream_thread(void *arg)
     struct vfw_capture *filter = arg;
     const unsigned int image_size = get_image_size(filter);
     struct read_frame_params params;
+    unsigned int errors = 0;
 
     for (;;)
     {
         IMediaSample *sample;
+        LONG sample_size;
         HRESULT hr;
         NTSTATUS status;
         BYTE *data;
@@ -166,12 +168,26 @@ static DWORD WINAPI stream_thread(void *arg)
 
         if (FAILED(hr = IMemAllocator_GetBuffer(filter->source.pAllocator, &sample, NULL, NULL, 0)))
         {
-            ERR("Failed to get sample, hr %#lx.\n", hr);
-            break;
+            /* Downstream has no sample to hand out at the moment. That is a
+             * temporary condition, not a reason to end capture, so keep the
+             * stream alive and ask again. */
+            if (!errors++) WARN("Failed to get sample, hr %#lx.\n", hr);
+            Sleep(10);
+            continue;
         }
 
         IMediaSample_SetActualDataLength(sample, image_size);
-        IMediaSample_GetPointer(sample, &data);
+        hr = IMediaSample_GetPointer(sample, &data);
+        sample_size = SUCCEEDED(hr) ? IMediaSample_GetSize(sample) : 0;
+        if (FAILED(hr) || sample_size < (LONG)image_size)
+        {
+            /* Never read into a buffer we cannot write a whole frame to. */
+            if (!errors++) WARN("Unusable sample, hr %#lx, size %ld for %u bytes.\n",
+                    hr, sample_size, image_size);
+            IMediaSample_Release(sample);
+            Sleep(10);
+            continue;
+        }
 
         params.device = filter->device;
         params.data = data;
@@ -186,17 +202,27 @@ static DWORD WINAPI stream_thread(void *arg)
         }
         if (!status)
         {
+            /* The device failed this read. Keep the stream running and try
+             * again: the camera may recover, and stopping here would leave the
+             * filter alive with no frames ever being delivered again. */
+            if (!errors++) WARN("Failed to read a frame from the device.\n");
             IMediaSample_Release(sample);
-            break;
+            Sleep(10);
+            continue;
         }
 
         hr = IMemInputPin_Receive(filter->source.pMemInputPin, sample);
         IMediaSample_Release(sample);
         if (FAILED(hr))
         {
-            ERR("IMemInputPin::Receive() returned %#lx.\n", hr);
-            break;
+            /* The sink refused this frame. Deliver the next one instead of
+             * tearing the stream down. */
+            if (!errors++) WARN("IMemInputPin::Receive() returned %#lx.\n", hr);
+            Sleep(10);
+            continue;
         }
+
+        errors = 0;
     }
 
     return 0;
