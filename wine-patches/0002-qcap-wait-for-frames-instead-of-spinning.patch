diff --git a/dlls/qcap/v4l.c b/dlls/qcap/v4l.c
index a963372..f6218a4 100644
--- a/dlls/qcap/v4l.c
+++ b/dlls/qcap/v4l.c
@@ -45,6 +45,7 @@
 #include <linux/videodev2.h>
 #endif
 #include <unistd.h>
+#include <poll.h>
 
 #include "ntstatus.h"
 #include "initguid.h"
@@ -355,14 +356,38 @@ static NTSTATUS v4l_device_read_frame( void *args )
 {
     const struct read_frame_params *params = args;
     struct video_capture_device *device = get_device(params->device);
+    struct pollfd pollfd = {.fd = device->fd, .events = POLLIN};
+    int ret;
 
-    while (video_read(device->fd, device->image_data, device->image_size) < 0)
+    for (;;)
     {
+        if (video_read(device->fd, device->image_data, device->image_size) >= 0)
+            break;
+
         if (errno != EAGAIN)
         {
             ERR("Failed to read frame: %s\n", strerror(errno));
             return FALSE;
         }
+
+        /* The descriptor is non-blocking, so retrying the read immediately
+         * spins at full speed for as long as no frame is available, and the
+         * capture thread then never notices that it was asked to stop. Wait
+         * for the device instead, and hand control back to the caller when
+         * nothing arrives, so that it can check its state and call again. */
+        if ((ret = poll(&pollfd, 1, 100)) < 0)
+        {
+            if (errno == EINTR) continue;
+            ERR("Failed to wait for frame: %s\n", strerror(errno));
+            return FALSE;
+        }
+        if (!ret)
+            return V4L_E_FRAME_TIMEOUT;
+        if (pollfd.revents & (POLLERR | POLLHUP | POLLNVAL))
+        {
+            ERR("Error while waiting for a frame, revents %#x.\n", pollfd.revents);
+            return FALSE;
+        }
     }
 
     reverse_image(device, params->data, device->image_data);
